	@$(QMAKE) 'QMAKE_CFLAGS_RELEASE=-O2 -g -pipe -Wall -Wp,-D_FORTIFY_SOURCE=2 -fexceptions -fstack-protector --param=ssp-buffer-size=4 -Wformat -Wformat-security -march=armv8-a' 'QMAKE_CFLAGS_DEBUG=-O2 -g -pipe -Wall -Wp,-D_FORTIFY_SOURCE=2 -fexceptions -fstack-protector --param=ssp-buffer-size=4 -Wformat -Wformat-security -march=armv8-a' 'QMAKE_CXXFLAGS_RELEASE=-O2 -g -pipe -Wall -Wp,-D_FORTIFY_SOURCE=2 -fexceptions -fstack-protector --param=ssp-buffer-size=4 -Wformat -Wformat-security -march=armv8-a' 'QMAKE_CXXFLAGS_DEBUG=-O2 -g -pipe -Wall -Wp,-D_FORTIFY_SOURCE=2 -fexceptions -fstack-protector --param=ssp-buffer-size=4 -Wformat -Wformat-security -march=armv8-a' QMAKE_STRIP=: PREFIX=/usr LIBDIR=/usr/lib64 -o Makefile jolla-settings.pro

qmake_all: FORCE


all: Makefile $(TARGET)

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents translations/settings-syncthing.ts $(DISTDIR)/
	$(COPY_FILE) --parents translations/settings-syncthing.ts $(DISTDIR)/


clean: compiler_clean
	-$(DEL_FILE) *~ core *.core


distclean: clean
	-$(DEL_FILE) $(TARGET)
	-$(DEL_FILE) $(TARGET0) $(TARGET1) $(TARGET2) $(TARGETA)
	-$(DEL_FILE) Makefile


####### Sub-libraries

check: first

benchmark: first

compiler_qm_make_all: translations/settings-syncthing.qm
compiler_qm_clean:
	-$(DEL_FILE) translations/settings-syncthing.qm
translations/settings-syncthing.qm: translations/settings-syncthing.ts
	@echo compiling translations/settings-syncthing.ts; lrelease -removeidentical -idbased -silent translations/settings-syncthing.ts -qm translations/settings-syncthing.qm

compiler_yacc_decl_make_all:
compiler_yacc_decl_clean:
compiler_yacc_impl_make_all:
compiler_yacc_impl_clean:
compiler_lex_make_all:
compiler_lex_clean:
compiler_clean: compiler_qm_clean

####### Compile

####### Install

install_settings-ui: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/jolla-settings/pages/syncthing || mkdir -p $(INSTALL_ROOT)/usr/share/jolla-settings/pages/syncthing
	-$(INSTALL_FILE) /home/andrea/projects/Jolla/harbour-Syncthing/jolla-settings/pages/syncthing/mainpage.qml $(INSTALL_ROOT)/usr/share/jolla-settings/pages/syncthing/

uninstall_settings-ui: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/jolla-settings/pages/syncthing/mainpage.qml
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/jolla-settings/pages/syncthing/


install_translations: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/translations || mkdir -p $(INSTALL_ROOT)/usr/share/translations
	-$(INSTALL_FILE) /home/andrea/projects/Jolla/harbour-Syncthing/jolla-settings/translations/*.qm $(INSTALL_ROOT)/usr/share/translations/

uninstall_translations: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/translations/*.qm
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/translations/


install: install_settings-ui install_translations  FORCE

uninstall: uninstall_settings-ui uninstall_translations  FORCE

FORCE:

