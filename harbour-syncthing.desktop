[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Categories=Network;
Icon=harbour-syncthing
Exec=harbour-syncthing
Name=Syncthing
Comment=Continuous Replication Synchronization Thing

[X-HarbourBackup]
BackupPathList=.config/dev.scarpino/harbour-syncthing/

[X-Sailjail]
Permissions=Internet;AppLaunch;Privileged
OrganizationName=dev.scarpino
ApplicationName=harbour-syncthing
